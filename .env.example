# Copie para .env e ajuste. Sem .env, o projeto roda com SQLite e valores de desenvolvimento.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-com-mais-de-32-caracteres
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco: deixe DB_ENGINE vazio para usar SQLite; use "postgres" para PostgreSQL
DB_ENGINE=
DB_NAME=cursos
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
